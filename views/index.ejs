<%- include('partials_header') %>
<section class="hero"><div><span class="tag">Comercio local seguro y organizado</span><h1>Compra y vende en Tlapa desde una sola plataforma.</h1><p>ImpulsaTlapa conecta a comerciantes y compradores locales con catálogos claros, búsqueda sencilla y contacto directo por WhatsApp.</p><a class="btn" href="/auth/register">Comenzar ahora</a></div><div class="hero-card"><h3>Busca productos locales</h3><form class="search" method="GET"><input name="q" placeholder="Ej. ropa, comida, artesanías" value="<%= q %>"><select name="category"><option value="">Todas las categorías</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(category)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><button>Buscar</button></form></div></section>
<section class="section-title"><h2>Productos disponibles</h2><p>Catálogo simple para facilitar la visibilidad de negocios locales.</p></section>
<div class="grid"><% products.forEach(p=>{ %><article class="card"><img src="<%= p.image %>" alt="<%= p.name %>"><div class="card-body"><span class="cat"><%= p.category %></span><h3><%= p.name %></h3><p><%= p.description %></p><strong>$<%= Number(p.price).toFixed(2) %></strong><small>Vendedor: <%= p.seller %></small><a class="whatsapp" target="_blank" href="https://wa.me/52<%= p.phone %>?text=Hola,%20vi%20tu%20producto%20<%= encodeURIComponent(p.name) %>%20en%20ImpulsaTlapa">Contactar por WhatsApp</a></div></article><% }) %><% if(products.length===0){ %><p>No hay productos registrados todavía.</p><% } %></div>
<%- include('partials_footer') %>
