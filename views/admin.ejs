<%- include('partials_header') %><section class="panel"><h1>Panel de administración</h1><h2>Usuarios</h2><div class="table-wrap"><table><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acción</th></tr><% users.forEach(u=>{ %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.active?'Activo':'Inactivo' %></td><td><form method="POST" action="/admin/users/toggle/<%= u.id %>"><button>Activar/Desactivar</button></form></td></tr><% }) %></table></div><h2>Productos</h2><div class="table-wrap"><table><tr><th>Producto</th><th>Vendedor</th><th>Categoría</th><th>Estado</th><th>Acción</th></tr><% products.forEach(p=>{ %><tr><td><%= p.name %></td><td><%= p.seller %></td><td><%= p.category %></td><td><%= p.active?'Activo':'Inactivo' %></td><td><form method="POST" action="/products/delete/<%= p.id %>"><button class="danger">Eliminar</button></form></td></tr><% }) %></table></div></section><%- include('partials_footer') %>
