<%- include('partials_header') %><section class="panel"><h1>Mis productos</h1><form class="product-form" action="/products/create" method="POST" enctype="multipart/form-data"><input name="name" placeholder="Nombre del producto" required><input name="price" type="number" step="0.01" placeholder="Precio" required><select name="category_id" required><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select><textarea name="description" placeholder="Descripción"></textarea><input type="file" name="image" accept="image/*"><button class="btn">Publicar producto</button></form><div class="table-wrap"><table><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Acción</th></tr><% products.forEach(p=>{ %><tr><td><%= p.name %></td><td><%= p.category %></td><td>$<%= p.price %></td><td><form method="POST" action="/products/delete/<%= p.id %>"><button class="danger">Desactivar</button></form></td></tr><% }) %></table></div></section><%- include('partials_footer') %>
